# ==============================================================================
# LapWise Environment Configuration
# ==============================================================================
# You can provide EITHER Groq (Open-Source Llama 3) OR Google Gemini (or both!)
# If no key is set, LapWise will smoothly use its built-in heuristic engine.

# 1. Groq API Key (Runs open-source Llama 3.3 70B at ultra-high speed for free)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini API Key (Alternative free option via Google AI Studio)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
